# Ollama endpoint + model
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# Bot language: sk | en  (sets prompt, greeting, STT language and default voice)
BOT_LANGUAGE=sk

# Whisper STT
WHISPER_MODEL=small
# STT_LANGUAGE=sk        # override; empty = auto-detect

# Piper TTS voice override (default comes from BOT_LANGUAGE)
# PIPER_VOICE=sk_SK-lili-medium
